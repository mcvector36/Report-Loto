<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema principala Report-Loto -->
    <style name="Theme.ReportLoto" parent="Theme.AppCompat.Light.DarkActionBar">

        <!-- Culori Report-Loto -->
        <item name="colorPrimary">@color/loto_green</item>
        <item name="colorPrimaryDark">@color/loto_green</item>
        <item name="colorAccent">@color/loto_light</item>

    </style>

    <!-- Tema fara ActionBar -->
    <style name="Theme.ReportLoto.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- AppBar -->
    <style
        name="Theme.ReportLoto.AppBarOverlay"
        parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <!-- Popup -->
    <style
        name="Theme.ReportLoto.PopupOverlay"
        parent="ThemeOverlay.AppCompat.Light" />

</resources>